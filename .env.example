# Copie para .env (`cp .env.example .env`). O servidor carrega o .env no boot
# (godotenv) sem sobrescrever variáveis já definidas no ambiente real.

# Ambiente da aplicação. "dev" (ou development/local) liga o logger de console
# colorido; vazio/qualquer outro = logger JSON de produção.
APP_ENV=dev

# --- Banco de dados (Postgres) ---------------------------------------------
# Opção A: defina DATABASE_URL para sobrescrever tudo de uma vez.
# DATABASE_URL=postgres://lucid:lucid@localhost:5432/lucid?sslmode=disable
#
# Opção B: variáveis individuais (defaults "lucid" para usuário/senha/banco).
DB_HOST=localhost
DB_PORT=5432
DB_USER=lucid
DB_PASSWORD=lucid
DB_NAME=lucid
DB_SSLMODE=disable
