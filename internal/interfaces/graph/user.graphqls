# Fragmento de schema do bounded context de USUÁRIO. Estende os tipos raiz
# Query/Mutation (definidos em schema.graphqls) — um único subgraph federado.

type User @key(fields: "id") {
  id: ID!
  name: String!
  email: String!
}

input CreateUserInput {
  name: String! @binding(constraint: "notblank,max=120")
  email: String! @binding(constraint: "required,email")
}

input UpdateUserInput {
  id: ID! @binding(constraint: "required")
  name: String @binding(constraint: "min=1,max=120")
  email: String @binding(constraint: "email")
}

extend type Query {
  "Busca um usuário por id."
  user(id: ID!): User
  "Lista todos os usuários."
  users: [User!]!
}

extend type Mutation {
  "Cria um usuário."
  createUser(input: CreateUserInput!): User!
  "Atualiza nome e/ou e-mail de um usuário."
  updateUser(input: UpdateUserInput!): User!
}
